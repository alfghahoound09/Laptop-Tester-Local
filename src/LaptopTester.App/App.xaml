<Application x:Class="LaptopTester.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LaptopTester.App.Converters"
             xmlns:models="clr-namespace:LaptopTester.Core.Models;assembly=LaptopTester.Core">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
            <conv:StatusToBgBrushConverter x:Key="StatusToBgBrush"/>
            <conv:VerdictToBrushConverter x:Key="VerdictToBrush"/>
            <conv:VerdictToBgBrushConverter x:Key="VerdictToBgBrush"/>
            <conv:EqualsToBoolConverter x:Key="EqBool"/>
            <conv:EqualsToVisibilityConverter x:Key="EqVis"/>
            <conv:PositiveIntToVisibilityConverter x:Key="CountVis"/>
            <conv:ZeroIntToVisibilityConverter x:Key="ZeroVis"/>

            <DataTemplate x:Key="TestStatusBadgeTemplate" DataType="{x:Type models:TestStatus}">
                <Border Background="{Binding Converter={StaticResource StatusToBgBrush}}"
                        BorderBrush="{Binding Converter={StaticResource StatusToBrush}}"
                        BorderThickness="1" CornerRadius="4" Padding="9,4"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding Converter={StaticResource StatusToBrush}}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Converter={StaticResource StatusToBrush}}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <Style x:Key="PassActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:TestStatus.Passed}">
                        <Setter Property="Background" Value="{StaticResource StatusPassBgBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource StatusPassBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource StatusPassBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FailActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:TestStatus.Failed}">
                        <Setter Property="Background" Value="#DC2626"/>
                        <Setter Property="BorderBrush" Value="#F87171"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
