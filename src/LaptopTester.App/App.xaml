<Application x:Class="LaptopTester.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LaptopTester.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
            <conv:EqualsToBoolConverter x:Key="EqBool"/>
            <conv:EqualsToVisibilityConverter x:Key="EqVis"/>
            <conv:PositiveIntToVisibilityConverter x:Key="CountVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
