<UserControl x:Class="LaptopTester.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Page Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding TitleText}" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding QuickTestBtnLabel}" Command="{Binding StartQuickTestCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="{Binding RescanLabel}" Command="{Binding ScanSystemCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Quick Launch 4-Tile Strip -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <UniformGrid Columns="4">
                    <Button Command="{Binding OpenHardwareTileCommand}" CommandParameter="Hardware" Style="{StaticResource SecondaryButtonStyle}" Background="Transparent" BorderThickness="0" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="{StaticResource AccentGreenMutedBrush}" CornerRadius="10" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Path Data="{StaticResource IconCpu}" Fill="{StaticResource AccentGreenHoverBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding TileHardware}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenHardwareTileCommand}" CommandParameter="Battery" Style="{StaticResource SecondaryButtonStyle}" Background="Transparent" BorderThickness="0" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#163322" CornerRadius="10" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Path Data="{StaticResource IconBattery}" Fill="#22C55E" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding TileBattery}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenHardwareTileCommand}" CommandParameter="AntiFake" Style="{StaticResource SecondaryButtonStyle}" Background="Transparent" BorderThickness="0" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#332714" CornerRadius="10" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Path Data="{StaticResource IconShield}" Fill="#F59E0B" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding TileAntiFake}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenHardwareTileCommand}" CommandParameter="Thermal" Style="{StaticResource SecondaryButtonStyle}" Background="Transparent" BorderThickness="0" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#38181A" CornerRadius="10" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Path Data="{StaticResource IconGauge}" Fill="#EF4444" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding TileBenchmark}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>

            <!-- Two-Column System Info + Overview -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Card: System Info -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Path Data="{StaticResource IconLaptop}" Fill="{StaticResource AccentGreenHoverBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SystemInfoHeader}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,9"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModelText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="OS" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,9"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OsText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,9"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CpuText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="RAM" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,9"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RamText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="GPU" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,9"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GpuText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ổ cứng / Disk" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,9"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StorageText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Màn hình" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,9"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DisplayText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Pin / Battery" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding BatteryText}" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenHoverBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right Card: Product Info & Tips -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="10" Width="46" Height="46" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconSettings}" Fill="#081A0E" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding AboutTitle}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Clean-room WPF .NET 10 Diagnostic Suite" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding AboutDesc}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tính năng chính:" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenHoverBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="• Đối chiếu WMI / Registry / SMBIOS" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="• Kiểm tra Pin + Stress Test 30s" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="• Benchmark CPU / RAM / Ổ cứng" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ngoại vi &amp; Báo cáo:" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenHoverBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="• Màn hình, Bàn phím, Touchpad" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="• Loa Stereo, Mic, Webcam, USB" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="• Xuất báo cáo HTML / JSON" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource AccentGreenMutedBrush}" BorderBrush="#235436" BorderThickness="1" CornerRadius="8" Padding="12">
                            <TextBlock Text="{Binding TipText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Status Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SubCardBorderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Phiên hiện tại:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CompletedCountText}" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenHoverBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SubCardBorderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Chế độ quyền:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding PrivilegeBadge}" FontWeight="SemiBold"/>
                        <TextBlock Text="  ·  Phím tắt F1–F7" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
