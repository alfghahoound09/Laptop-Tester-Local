<Window x:Class="LaptopTester.App.Views.FullScreenTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        Background="Black"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        KeyDown="Window_KeyDown">
    <Grid x:Name="RootGrid">
        <Border x:Name="HintBanner" Background="#B0121212" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
