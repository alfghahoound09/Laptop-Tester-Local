<UserControl x:Class="LaptopTester.App.Views.HardwareHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sub-navigation pill bar -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="5" HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SubTabRadioStyle}" Content="Phần Cứng" IsChecked="{Binding ActiveSubTab, Converter={StaticResource EqBool}, ConverterParameter=Hardware, Mode=OneWay}" Command="{Binding SelectSubTabCommand}" CommandParameter="Hardware"/>
                <RadioButton Style="{StaticResource SubTabRadioStyle}" Content="Chống Fake (3 Nguồn)" IsChecked="{Binding ActiveSubTab, Converter={StaticResource EqBool}, ConverterParameter=AntiFake, Mode=OneWay}" Command="{Binding SelectSubTabCommand}" CommandParameter="AntiFake"/>
                <RadioButton Style="{StaticResource SubTabRadioStyle}" Content="Kiểm Tra Pin" IsChecked="{Binding ActiveSubTab, Converter={StaticResource EqBool}, ConverterParameter=Battery, Mode=OneWay}" Command="{Binding SelectSubTabCommand}" CommandParameter="Battery"/>
                <RadioButton Style="{StaticResource SubTabRadioStyle}" Content="Nhiệt Độ &amp; Benchmark" IsChecked="{Binding ActiveSubTab, Converter={StaticResource EqBool}, ConverterParameter=Thermal, Mode=OneWay}" Command="{Binding SelectSubTabCommand}" CommandParameter="Thermal"/>
                <RadioButton Style="{StaticResource SubTabRadioStyle}" Content="Ổ Cứng &amp; Hệ Thống" IsChecked="{Binding ActiveSubTab, Converter={StaticResource EqBool}, ConverterParameter=StorageAudit, Mode=OneWay}" Command="{Binding SelectSubTabCommand}" CommandParameter="StorageAudit"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. HARDWARE OVERVIEW -->
                <StackPanel Visibility="{Binding ActiveSubTab, Converter={StaticResource EqVis}, ConverterParameter=Hardware}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Thông Tin Phần Cứng" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="{Binding StatusBanner}" Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Quét lại phần cứng" Command="{Binding RefreshHardwareCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Text="{Binding HardwareReport.Cpu.Name}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,4"/>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5">
                                    <Run Text="{Binding HardwareReport.Cpu.Cores, Mode=OneWay}"/><Run Text="C / "/>
                                    <Run Text="{Binding HardwareReport.Cpu.Threads, Mode=OneWay}"/><Run Text="T · "/>
                                    <Run Text="{Binding HardwareReport.Cpu.MaxClockMhz, Mode=OneWay}"/><Run Text=" MHz"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="RAM" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Text="{Binding HardwareReport.Summary.RamSummary}" FontSize="15" FontWeight="Bold" Margin="0,6,0,4"/>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5">
                                    <Run Text="Slots: "/><Run Text="{Binding HardwareReport.Ram.UsedSlots, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding HardwareReport.Ram.TotalSlots, Mode=OneWay}"/>
                                    <Run Text=" · Usable: "/><Run Text="{Binding HardwareReport.Ram.UsableGb, Mode=OneWay}"/><Run Text=" GB"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="MÀN HÌNH &amp; GPU" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Text="{Binding HardwareReport.Summary.GpuSummary}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,4"/>
                                <TextBlock Text="{Binding HardwareReport.Summary.DisplaySummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="CHI TIẾT THANH RAM (SLOTS)" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding RamModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SubCardBorderStyle}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Slot}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CapacityGb, StringFormat='{}{0:0.#} GB'}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SpeedMhz, StringFormat='{}{0} MHz'}" Foreground="{StaticResource AccentGreenHoverBrush}"/>
                                                <TextBlock Grid.Column="3" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding MemoryType, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Manufacturer, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PartNumber, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Ổ CỨNG &amp; MÀN HÌNH ĐANG KẾT NỐI" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SubCardBorderStyle}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Model}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding InterfaceType, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding MediaCategory, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeGb, StringFormat='{}{0:0.#} GB'}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="3" Text="{Binding HealthStatus}" Foreground="{StaticResource AccentGreenHoverBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2. ANTI-FAKE 3-SOURCE AUDIT -->
                <StackPanel Visibility="{Binding ActiveSubTab, Converter={StaticResource EqVis}, ConverterParameter=AntiFake}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Chống Giả Mạo Phần Cứng" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Đối chiếu độc lập WMI, Registry và SMBIOS firmware để phát hiện máy sửa thông số" Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Quét Phát Hiện" Command="{Binding RunAntiFakeScanCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{Binding AntiFakeIsClean, Converter={StaticResource StatusToBrush}}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AntiFakeBannerText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="SO SÁNH THÔNG SỐ TỪ NHIỀU NGUỒN (WMI / REGISTRY / SMBIOS)" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,12"/>
                            <Grid Margin="14,0,14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="THÀNH PHẦN" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Grid.Column="1" Text="WINDOWS / WMI" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Grid.Column="2" Text="REGISTRY / OS" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Grid.Column="3" Text="SMBIOS FIRMWARE" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Grid.Column="4" Text="TRẠNG THÁI" Style="{StaticResource SectionEyebrowStyle}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Comparisons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SubCardBorderStyle}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Component}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding WmiValue}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding RegistryValue}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SmbiosValue}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Note}" Foreground="{Binding IsConsistent, Converter={StaticResource StatusToBrush}}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding Indicators.Count, Converter={StaticResource CountVis}}">
                        <StackPanel>
                            <TextBlock Text="DẤU HIỆU PHÁT HIỆN" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Indicators}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource StatusWarnBgBrush}" BorderBrush="#5C441B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource StatusWarnBrush}"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. BATTERY HEALTH & STRESS TEST -->
                <StackPanel Visibility="{Binding ActiveSubTab, Converter={StaticResource EqVis}, ConverterParameter=Battery}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kiểm Tra Pin" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Đánh giá sức khỏe pin, chu kỳ sạc và chạy tải thực tế" Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Kiểm tra pin" Command="{Binding CheckBatteryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Bắt đầu / Dừng Stress Test (30s)" Command="{Binding ToggleBatteryStressCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,14">
                                    <Border Background="{StaticResource StatusPassBgBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="SỨC KHỎE" Style="{StaticResource SectionEyebrowStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Battery.HealthPercent, StringFormat='{}{0:F0}%'}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentGreenHoverBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource StatusPassBgBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="CHU KỲ SẠC" Style="{StaticResource SectionEyebrowStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Battery.CycleCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentGreenHoverBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="DUNG LƯỢNG THỰC" Style="{StaticResource SectionEyebrowStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Battery.FullChargedCapacityMwh, StringFormat='{}{0} mWh'}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="10" Padding="14">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="MỨC PIN / CÔNG SUẤT" Style="{StaticResource SectionEyebrowStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <Run Text="{Binding Battery.ChargePercent, Mode=OneWay}"/><Run Text="% · "/><Run Text="{Binding Battery.RateWatts, StringFormat='{}{0:0.0}W', Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5">
                                    <Run Text="Nhà sản xuất: "/><Run Text="{Binding Battery.Manufacturer, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Run Text="  ·  Thiết kế: "/><Run Text="{Binding Battery.DesignedCapacityMwh, Mode=OneWay}"/><Run Text=" mWh"/>
                                    <Run Text="  ·  Điện áp: "/><Run Text="{Binding Battery.VoltageVolts, StringFormat='{}{0:0.00}V', Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="STRESS TEST PIN &amp; CHECKLIST" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding StressStatusText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ProgressBar Value="{Binding StressProgressPercent}" Maximum="100" Height="8" Background="{StaticResource BgSurfaceBrush}" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,14"/>
                                <ItemsControl ItemsSource="{Binding BatteryChecklist}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,8"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 4. THERMAL & BENCHMARK -->
                <StackPanel Visibility="{Binding ActiveSubTab, Converter={StaticResource EqVis}, ConverterParameter=Thermal}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nhiệt Độ &amp; Benchmark" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="{Binding BenchmarkStatus}" Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Đọc nhiệt độ" Command="{Binding RefreshThermalCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Chạy Benchmark CPU/RAM/Disk" Command="{Binding RunBenchmarkCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="CPU BENCHMARK" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Text="{Binding Benchmark.CpuMultiScore, FallbackValue=—, StringFormat='{}Multi: {0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentGreenHoverBrush}" Margin="0,6,0,2"/>
                                <TextBlock Text="{Binding Benchmark.CpuSingleScore, FallbackValue=—, StringFormat='{}Single: {0:N0}'}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="MEMORY BANDWIDTH" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Text="{Binding Benchmark.MemoryBandwidthGbPerSec, FallbackValue=—, StringFormat='{}{0:0.##} GB/s'}" FontSize="22" FontWeight="Bold" Margin="0,6,0,2"/>
                                <TextBlock Text="{Binding Thermal.RamUsedPercent, FallbackValue=0, StringFormat='{}RAM Used: {0:0}%'}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="NHIỆT ĐỘ &amp; TẢI" Style="{StaticResource SectionEyebrowStyle}"/>
                                <TextBlock Text="{Binding Thermal.CpuPackageC, TargetNullValue='N/A (Standard User)', StringFormat='{}CPU: {0:0.#} °C'}" FontSize="20" FontWeight="Bold" Margin="0,6,0,2"/>
                                <TextBlock Text="{Binding Thermal.SourceNote}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- 5. STORAGE SPEED & SYSTEM AUDIT -->
                <StackPanel Visibility="{Binding ActiveSubTab, Converter={StaticResource EqVis}, ConverterParameter=StorageAudit}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ổ Cứng, Driver &amp; Startup Audit" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="{Binding StorageBenchResult}" Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Đo tốc độ Ổ cứng (128MB)" Command="{Binding RunStorageSpeedTestCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Quét Driver &amp; Startup" Command="{Binding RunSystemAuditCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="DRIVER ERRORS (WIN32_PNPENTITY)" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding DriverIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SubCardBorderStyle}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource StatusWarnBrush}" FontSize="12.5"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="STARTUP PROGRAMS" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding StartupEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SubCardBorderStyle}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Location}" Foreground="{StaticResource AccentGreenHoverBrush}" FontSize="11.5"/>
                                                    <TextBlock Text="{Binding Command}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
