<Window x:Class="LaptopTester.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopTester.App.ViewModels"
        xmlns:views="clr-namespace:LaptopTester.App.Views"
        Title="LaptopTester Open Edition"
        Width="1360" Height="820"
        MinWidth="1024" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuickTestViewModel}">
            <views:QuickTestView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareHubViewModel}">
            <views:HardwareHubView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceHubViewModel}">
            <views:DeviceHubView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Header (Spotify-inspired dark shell matching screenshots) -->
        <Border Grid.Row="0" Background="#121212" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid Background="{StaticResource BgPrimaryBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Left -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding GoBackCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="9,7" Margin="0,0,10,0"
                            AutomationProperties.Name="Back">
                        <TextBlock Text="←" FontSize="14" FontWeight="Bold"/>
                    </Button>

                    <Border Background="{StaticResource AccentGreenMutedBrush}" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="8" Width="34" Height="34" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconLaptop}" Fill="{StaticResource AccentGreenHoverBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="LaptopTester" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="6" Padding="7,3" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Border Background="{StaticResource AccentGreenMutedBrush}" CornerRadius="6" Padding="7,3" VerticalAlignment="Center">
                        <TextBlock Text="OPEN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreenHoverBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Center/Right Navigation Pill Bar -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="20" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqBool}, ConverterParameter=Dashboard, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppTab.Dashboard}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHome}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NavDashboard}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqBool}, ConverterParameter=QuickTest, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppTab.QuickTest}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconChecklist}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NavQuickTest}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqBool}, ConverterParameter=Hardware, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppTab.Hardware}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCpu}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NavHardware}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqBool}, ConverterParameter=Devices, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppTab.Devices}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconKeyboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NavDevices}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqBool}, ConverterParameter=Report, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppTab.Report}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReport}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NavReport}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqBool}, ConverterParameter=History, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppTab.History}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHistory}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NavHistory}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Right Controls: Language & Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleLanguageCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="11,7" Margin="0,0,8,0"
                            AutomationProperties.Name="Switch Language">
                        <TextBlock Text="{Binding LanguageLabel}" FontWeight="SemiBold"/>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppTab.Settings}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,8"
                            AutomationProperties.Name="Settings">
                        <Path Data="{StaticResource IconSettings}" Fill="{StaticResource TextPrimaryBrush}" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active Page Body -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="24,18,24,22"/>
    </Grid>
</Window>
