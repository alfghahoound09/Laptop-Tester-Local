<UserControl x:Class="LaptopTester.App.Views.QuickTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Quy Trình Kiểm Tra Nhanh (10 Bước)" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Chạy kiểm tra tự động phần cứng hoặc mở từng bài test ngoại vi để chấm điểm /100" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Chạy bước tự động" Command="{Binding RunAutoChecksCommand}" IsEnabled="{Binding IsRunningAuto, Converter={StaticResource InverseBool}}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Lưu Lịch Sử" Command="{Binding SaveQuickSessionCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Live Score Summary Banner -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AccentGreenMutedBrush}" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="10" Padding="18,10" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentScore}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentGreenHoverBrush}"/>
                            <TextBlock Text=" / 100" FontSize="15" VerticalAlignment="Bottom" Margin="2,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ĐÁNH GIÁ HIỆN TẠI" Style="{StaticResource SectionEyebrowStyle}"/>
                        <TextBlock Text="{Binding VerdictText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 10 Steps List -->
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SubCardBorderStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="8,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Weight, StringFormat='  (-{0}đ)'}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Mở test"
                                            Visibility="{Binding DeviceTarget, Converter={StaticResource NullToVis}}"
                                            Command="{Binding DataContext.OpenDeviceTestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,6,0"/>
                                    <Button Content="Đạt"
                                            Command="{Binding DataContext.SetStepStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id, StringFormat='{}{0}|Pass'}"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,6,0"/>
                                    <Button Content="Lỗi"
                                            Command="{Binding DataContext.SetStepStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id, StringFormat='{}{0}|Fail'}"
                                            Style="{StaticResource DangerButtonStyle}" Padding="10,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
