<UserControl x:Class="LaptopTester.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Báo Cáo Tổng Hợp" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Lưu Lịch Sử" Command="{Binding SaveSessionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Xuất JSON" Command="{Binding ExportJsonCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Xuất HTML / In PDF" Command="{Binding ExportHtmlCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AccentGreenMutedBrush}" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="10" Padding="20,10" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Score}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentGreenHoverBrush}"/>
                            <TextBlock Text=" / 100" FontSize="15" VerticalAlignment="Bottom" Margin="2,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VerdictText}" FontSize="17" FontWeight="Bold"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Margin="0,8,0,0" ToolTip="Ghi chú báo cáo / Report notes"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="KẾT QUẢ CÁC HẠNG MỤC" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SubCardBorderStyle}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding Deductions.Count, Converter={StaticResource CountVis}}">
                <StackPanel>
                    <TextBlock Text="ĐIỂM TRỪ" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Deductions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SubCardBorderStyle}" Margin="0,0,0,8">
                                    <TextBlock>
                                        <Run Text="{Binding PointsDeducted, StringFormat='-{0}đ · ', Mode=OneWay}" Foreground="{StaticResource StatusFailBrush}" FontWeight="Bold"/>
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=": "/><Run Text="{Binding Reason, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
