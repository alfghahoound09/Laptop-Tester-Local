<UserControl x:Class="LaptopTester.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding TitleText}" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding PrivilegeHeader}" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding PrivilegeText}" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding HistoryFolder, StringFormat='{}Saved reports folder: {0}'}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                    <Button Content="Open Saved Reports Folder" Command="{Binding OpenHistoryFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="ABOUT LAPTOPTESTER" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,8"/>
                    <TextBlock Text="LaptopTester Open Edition — Laptop Hardware &amp; Pre-Purchase Diagnostic Suite" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="Checks genuine hardware specs against BIOS firmware to catch edited specs, measures battery wear, tests screen pixels, keyboard, audio, USB ports, and exports HTML/JSON reports." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
